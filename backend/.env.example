# 后端环境变量示例：复制为 .env 后按本地环境修改
# 服务名称与监听地址
SERVICE_NAME=idea-doc-server
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# MySQL 连接串，格式：mysql://用户名:密码@主机:端口/库名
# 注意：库名固定为 idea_doc，字符集为 utf8mb4
DATABASE_URL=mysql://root:你的密码@127.0.0.1:3306/idea_doc

# 允许跨域访问的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：本服务=debug，HTTP 中间件=debug，其他=info
RUST_LOG=idea_doc_backend=debug,tower_http=debug,info
